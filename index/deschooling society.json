  "chapters": [
    {
      "id": "deschooling-society-ch-001",
      "title": "Introduction",
      "summary": "The author credits his interest in public education to Everett Reimer, with whom he began questioning the value of obligatory schooling in 1958. The book argues that universal education through schooling is not feasible and that the right to learn is curtailed by the obligation to attend school.",
      "claim_ids": [
        "deschooling-society-001",
        "deschooling-society-002"
      ]
    },
    {
      "id": "deschooling-society-ch-002",
      "title": "Why We Must Disestablish School",
      "summary": "Schools confuse process with substance, teaching students that more treatment leads to better results and that institutional performance equals the values these institutions claim to serve.",
      "claim_ids": [
        "deschooling-society-003",
        "deschooling-society-004",
        "deschooling-society-005",
        "deschooling-society-006",
        "deschooling-society-007"
      ]
    },
    {
      "id": "deschooling-society-ch-003",
      "title": "Phenomenology of School",
      "summary": "School is defined as the age-specific, teacher-related process requiring full-time attendance at an obligatory curriculum, based on three unquestioned premises that deserve examination.",
      "claim_ids": [
        "deschooling-society-008",
        "deschooling-society-009",
        "deschooling-society-010",
        "deschooling-society-011",
        "deschooling-society-012"
      ]
    },
    {
      "id": "deschooling-society-ch-004",
      "title": "Ritualization of Progress",
      "summary": "The university represents the final stage of the most comprehensive initiation rite in world history, creating a new form of alienation and serving as the knowledge industry's primary institution.",
      "claim_ids": [
        "deschooling-society-013",
        "deschooling-society-014",
        "deschooling-society-015",
